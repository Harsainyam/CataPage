<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Log in — Catalog Reels' }) %>
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-card">
      <h1>Log in</h1>
      <p class="sub">Manage your catalog and see how it's performing.</p>

      <% if (error) { %><div class="form-error"><%= error %></div><% } %>

      <form action="/login" method="POST">
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required />
        </div>
        <button class="btn btn-primary" type="submit" style="width:100%;">Log in</button>
      </form>

      <div class="auth-switch">New here? <a href="/signup">List your products</a></div>
    </div>
  </div>
</body>
</html>
